---
import Image from '~/components/common/Image.astro';
import stripeLogo from '~/assets/images/partners/stripe.svg';
import krakenLogo from '~/assets/images/partners/kraken.svg';
import bitgoLogo from '~/assets/images/partners/bitgo.svg';
import bitcoinLogo from '~/assets/images/partners/bitcoin-logo-white.svg';
import { getLocaleFromPath, useTranslations } from '~/i18n';

const locale = getLocaleFromPath(new URL(Astro.url).pathname);
const t = useTranslations(locale);

const stripeSrc = typeof stripeLogo === 'string' ? stripeLogo : stripeLogo.src;
const krakenSrc = typeof krakenLogo === 'string' ? krakenLogo : krakenLogo.src;
const bitgoSrc = typeof bitgoLogo === 'string' ? bitgoLogo : bitgoLogo.src;
const bitcoinSrc = typeof bitcoinLogo === 'string' ? bitcoinLogo : bitcoinLogo.src;

const partners = [
  {
    image: '~/assets/images/partners/blockdaemon-white.png',
    title: 'Blockdaemon',
    href: 'https://blockdaemon.com/',
    height: 32,
  },
  {
    image: '~/assets/images/partners/fireblocks-logo-white.png',
    title: 'Fireblocks',
    href: 'https://www.fireblocks.com/',
    height: 22,
  },
  {
    image: '~/assets/images/partners/crypto-dot-com-logo-white.png',
    title: 'Crypto.com',
    href: 'https://crypto.com/',
    height: 32,
  },
  {
    image: '~/assets/images/partners/halborn-logo-white.png',
    title: 'Halborn',
    href: 'https://www.halborn.com/',
    height: 18,
  },
  {
    image: '~/assets/images/partners/merkle-logo-white.png',
    title: 'Merkle Science',
    href: 'https://www.merklescience.com/',
    height: 32,
  },
  {
    image: '~/assets/images/partners/moonpay-logo-white.png',
    title: 'Moonpay',
    href: 'https://www.moonpay.com/',
    height: 32,
  },
  { image: '~/assets/images/partners/banxa-logo.png', title: 'Banxa', href: 'https://banxa.com/', height: 22 },
  {
    image: '~/assets/images/partners/bfc-logo.png',
    title: 'Bitcoin For Corporations',
    href: 'https://bitcoinforcorporations.com/',
    height: 34,
  },
  {
    image: '~/assets/images/partners/bmtv-logo-white.png',
    title: 'Bitcoin Magazine TV',
    href: 'https://bitcoinmagazine.com/bmtv',
    height: 28,
  },
  { isSvg: true, src: stripeSrc, title: 'Stripe', href: 'https://stripe.com/', width: 63, height: 27 },
  { isSvg: true, src: krakenSrc, title: 'Kraken', href: 'https://www.kraken.com/', width: 112, height: 19, offsetY: 3 },
  {
    isSvg: true,
    src: bitgoSrc,
    title: 'BitGo',
    href: 'https://www.bitgo.com/',
    width: 85,
    height: 29,
    offsetX: 2,
    offsetY: 4,
  },
  { isSvg: true, src: bitcoinSrc, title: 'Bitcoin', href: 'https://bitcoin.org/', width: 125, height: 26 },
];
---

<div>
  <h2 class="font-bold font-heading text-heading text-4xl text-center tracking-tight mb-4">
    {t('partners.heading')}
  </h2>
  <p class="text-center text-muted mb-10 max-w-2xl mx-auto">
    {t('partners.subheading')}
  </p>

  <div class="flex flex-col md:flex-row md:flex-wrap gap-6 items-center md:justify-center max-w-5xl mx-auto">
    {
      partners.map((partner) => (
        <a
          href={partner.href}
          target="_blank"
          rel="noopener"
          class="hover:opacity-70 transition-opacity duration-300 flex justify-center md:min-w-[120px]"
        >
          {partner.isSvg ? (
            <img
              src={partner.src}
              alt={partner.title}
              width={partner.width}
              height={partner.height}
              style={`width: ${partner.width}px; height: ${partner.height}px; min-width: ${partner.width}px;${partner.offsetX || partner.offsetY ? ` transform: translate(${partner.offsetX ?? 0}px, ${partner.offsetY ?? 0}px);` : ''}`}
            />
          ) : (
            <Image
              src={partner.image}
              alt={partner.title}
              height={partner.height ?? 32}
              width={200}
              style="object-fit: contain"
            />
          )}
        </a>
      ))
    }
  </div>
</div>
