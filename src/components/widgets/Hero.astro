---
import Button from '~/components/ui/Button.astro';
import { externalLinks } from '~/navigation';
import { getLocaleFromPath, useTranslations } from '~/i18n';

const locale = getLocaleFromPath(new URL(Astro.url).pathname);
const t = useTranslations(locale);
---

<section class="relative bg-black not-prose" id="hero">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="py-12 md:py-20">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <!-- Left Side: Copy + Button Groups -->
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <h1
            class="text-3xl md:text-[2.5rem] font-bold font-heading dark:text-gray-200 leading-[1.15] tracking-tight mb-6"
          >
            {t('hero.heading_prefix')}<span class="text-primary">{t('hero.heading_bitcoin')}</span>{
              t('hero.heading_sep1')
            }<span class="text-vfx-blue">{t('hero.heading_intelligent')}</span>{t('hero.heading_sep2')}<span
              class="text-vfx-green">{t('hero.heading_agentic')}</span
            >
          </h1>

          <p class="text-xl text-muted mb-4">
            {t('hero.tagline')}
          </p>

          <p class="text-base text-gray-400 mb-10">
            {t('hero.description')}
          </p>

          <!-- Button Group: Individuals -->
          <div class="mb-6">
            <p class="text-xs uppercase tracking-widest text-gray-500 mb-2 font-semibold">
              {t('hero.group_individuals')}
            </p>
            <div class="flex flex-wrap gap-2">
              <Button variant="blue" href="https://www.befree.io" target="_blank">{t('hero.cta_open_butterfly')}</Button
              >
              <Button variant="secondary" href="#" target="_blank">{t('hero.cta_open_pulsexai')}</Button>
              <Button variant="secondary" href={externalLinks.webWallet} target="_blank"
                >{t('hero.cta_download_wallet')}</Button
              >
            </div>
          </div>

          <!-- Button Group: Institutions -->
          <div class="mb-6">
            <p class="text-xs uppercase tracking-widest text-gray-500 mb-2 font-semibold">
              {t('hero.group_institutions')}
            </p>
            <div class="flex flex-wrap gap-2">
              <Button
                variant="secondary"
                href="https://docs.verifiedx.io/docs/introduction/institutional"
                target="_blank">{t('hero.cta_institutional_infra')}</Button
              >
              <Button variant="secondary" href="https://docs.verifiedx.io/docs/integration/vbtc" target="_blank"
                >{t('hero.cta_integrate_vbtc')}</Button
              >
            </div>
          </div>

          <!-- Button Group: Developers -->
          <div>
            <p class="text-xs uppercase tracking-widest text-gray-500 mb-2 font-semibold">
              {t('hero.group_developers')}
            </p>
            <div class="flex flex-wrap gap-2">
              <Button variant="secondary" href={externalLinks.docs} target="_blank"
                >{t('hero.cta_start_building')}</Button
              >
              <Button variant="secondary" href={externalLinks.githubOrg} target="_blank"
                >{t('hero.cta_code_repo')}</Button
              >
            </div>
          </div>
        </div>

        <!-- Right Side: CLI Terminal Visual -->
        <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <div
            class="rounded-lg border border-gray-700 bg-[#0a0a0a] p-6 md:p-8 font-mono text-sm md:text-base shadow-2xl"
          >
            <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-800">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
              <span class="ml-2 text-gray-500 text-xs">verifiedx://network</span>
            </div>
            <pre
              class="text-green-400 leading-relaxed whitespace-pre"><span class="text-primary font-bold">Bitcoin</span>
   &darr;
<span class="text-vfx-blue font-bold">VerifiedX</span>
   &darr;
<span class="text-gray-300">Payments</span> &bull; <span class="text-gray-300">DeFi</span> &bull; <span class="text-gray-300">Wallets</span> &bull; <span class="text-gray-300">AI Agents</span></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
