---
import merge from 'lodash.merge';
import { AstroSeo } from '@astrolib/seo';

import type { Props as AstroSeoProps } from '@astrolib/seo';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';
import { getLocaleFromPath, localizePath, locales } from '~/i18n';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const pathname = new URL(Astro.url).pathname;
const activeLocale = getLocaleFromPath(pathname);
const ogLocale = activeLocale === 'es' ? 'es' : 'en';
const alternates = locales.map((loc) => ({
  hreflang: loc === 'en' ? 'en-US' : loc,
  href: String(getCanonical(localizePath(pathname, loc))),
}));
const xDefault = String(getCanonical(localizePath(pathname, 'en')));

// Per-locale fallback description for pages that don't pass their own.
// Pages that do pass `description` in metadata (via t()) still win.
const localizedDefaults = {
  en: {
    title: METADATA?.title?.default,
    description: METADATA?.description,
  },
  es: {
    title: 'VerifiedX — El sistema operativo financiero para Bitcoin',
    description:
      'VerifiedX es el sistema operativo financiero que convierte a Bitcoin en capital financiero programable. Pagos autocustodiales, DeFi, vBTC, agentes tokenizados e infraestructura de nivel institucional impulsada por una red descentralizada.',
  },
} as const;

const seoProps: AstroSeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: ogLocale,
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: localizedDefaults[activeLocale].title,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: localizedDefaults[activeLocale].description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description,
    openGraph: { url: canonical, ...openGraph },
    twitter: twitter,
  }
);
---

<AstroSeo {...{ ...seoProps, openGraph: await adaptOpenGraphImages(seoProps?.openGraph, Astro.site) }} />
<meta name="keywords" content="VerifiedX, VFX, Bitcoin, vBTC, financial operating system, self-custodial, DeFi, blockchain, decentralized finance, Bitcoin sidechain, digital payments, tokenized agents, PulseXAI, Butterfly, SwitchBlade wallet, FROST MPC, institutional crypto, smart contracts, Web3" />
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefault} />
