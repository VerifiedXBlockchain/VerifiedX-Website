---
import Layout from '~/layouts/PageLayout.astro';
import HomeContent from '~/components/widgets/HomeContent.astro';
import { getLocaleFromPath, useTranslations } from '~/i18n';

const locale = getLocaleFromPath(new URL(Astro.url).pathname);
const t = useTranslations(locale);

const metadata = {
  title: t('home.meta_title'),
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <HomeContent />
</Layout>
