---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { getLocaleFromPath, useTranslations } from '~/i18n';

const locale = getLocaleFromPath(new URL(Astro.url).pathname);
const t = useTranslations(locale);

const title = t('not_found.meta_title');
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">{t('not_found.heading')}</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">{t('not_found.subheading')}</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          {t('not_found.body')}
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn ml-4">{t('not_found.back_home')}</a>
      </div>
    </div>
  </section>
</Layout>
